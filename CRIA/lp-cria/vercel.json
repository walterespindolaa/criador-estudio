{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|woff2|woff|ttf|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), payment=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/p/:codigo",
      "destination": "https://app.criasocialclub.com.br/p/:codigo",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "criador.criasocialclub.com.br"
        }
      ],
      "destination": "/comecar",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "socialmedia.criasocialclub.com.br"
        }
      ],
      "destination": "/comecar",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/comecar",
      "has": [
        {
          "type": "host",
          "value": "criador.criasocialclub.com.br"
        }
      ],
      "destination": "/lp-criador"
    },
    {
      "source": "/comecar",
      "has": [
        {
          "type": "host",
          "value": "socialmedia.criasocialclub.com.br"
        }
      ],
      "destination": "/lp-socialmidia"
    }
  ]
}
